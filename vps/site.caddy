# Buccanet, the relay and its web app. Published by root with vps-automation's
# publish-site.sh into /etc/caddy/conf.d/buccanet.caddy, imported from
# /etc/caddy/Caddyfile.
#
# The relay counts limits per client address from X-Real-IP (CLIENT_IP_HEADER in
# vps/compose.yaml), so Caddy sets it itself: from CF-Connecting-IP when the
# request comes from a Cloudflare address (https://www.cloudflare.com/ips), from
# the connection otherwise. Caddy replaces any X-Real-IP the client sent.
#
# The relay sends its own security headers and Content Security Policy. The live
# inbox (/api/v1/stream) is Server Sent Events: it is never compressed, so each
# event leaves as soon as the relay writes it.
(buccanet_cloudflare_addresses) {
	@cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
}

buccanet.laboetie.io {
	import edge_cloudflare_only
	# The relay refuses bodies above 256 KB itself (an approval carries a Welcome).
	import edge_body_limit 512KB
	import security_headers
	import buccanet_cloudflare_addresses
	@compressible not path /api/v1/stream
	encode @compressible zstd gzip
	handle @cloudflare {
		reverse_proxy 127.0.0.1:9530 {
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
			flush_interval -1
		}
	}
	handle {
		reverse_proxy 127.0.0.1:9530 {
			header_up X-Real-IP {remote_host}
			flush_interval -1
		}
	}
}
