{
  "name": "@buccanet/web",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "sdk": "wasm-pack build vendor/buccanet/core/buccanet-wasm --target web --release --out-dir ../../../../src/sdk/pkg --out-name buccanet && npm run icons",
    "icons": "uv run vendor/buccanet/design/logo/build-icons.py web .",
    "dev": "vite --port 8759 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "tsc -b",
    "preview": "vite preview --port 8759 --strictPort"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router": "7.9.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.14",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vite": "7.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@tailwindcss/oxide@4.1.14": true
  }
}
